{
  "name": "recordr",
  "version": "3.1.0",
  "description": "Rolling Sampler-style audio recorder with oscilloscope/spectrogram visualizers",
  "main": "dist/main/index.js",
  "author": "Serge",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:tests": "tsc -p tsconfig.test.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build:main && npm run build:tests && node --test \"dist/main/transcribe/*.test.js\" \"dist/renderer/lib/*.test.js\"",
    "test:electron": "npm run build && electron scripts/transcribe-electron-check.js",
    "test:packaged": "cross-env RECORDR_APP_DIR=release/win-unpacked electron scripts/transcribe-electron-check.js",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "start": "cross-env NODE_ENV=production electron ."
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.5",
    "electron-builder": "^24.13.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.serge.recordr",
    "productName": "Recordr",
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/koffi/**/*",
      "node_modules/@spotify/basic-pitch/**/*",
      "node_modules/@tensorflow/tfjs/**/*",
      "node_modules/@tensorflow/tfjs-core/**/*",
      "node_modules/@tensorflow/tfjs-backend-cpu/**/*",
      "node_modules/@tensorflow/tfjs-backend-webgl/**/*",
      "node_modules/@tensorflow/tfjs-converter/**/*",
      "node_modules/@tensorflow/tfjs-data/**/*",
      "node_modules/@tensorflow/tfjs-layers/**/*",
      "node_modules/@tensorflow/tfjs-core/dist/weights/**/*",
      "node_modules/@tonejs/midi/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsbuildinfo",
      "!**/dist/miniprogram/**"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "loopback-build",
        "to": "loopback-build",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.21.0",
    "@tonejs/midi": "^2.0.28",
    "koffi": "^3.1.5"
  }
}
